/-! ### The tables are exactly the rounded cosines (closes `tablesMatchP7`) -/


set_option maxHeartbeats 2000000 in  -- 168 entry proofs in one declaration; an elaboration budget, not a kernel option
theorem E1_round : ∀ a, a < 7 → ∀ n ∈ neurons [1, 2, 3], round ((((25 : ℕ) : ℝ)) * rE1 7 a n) = t1 a n := by
  intro a ha n hn
  have hn := mem_neurons123 n hn
  interval_cases a
  all_goals rcases hn with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  ·
    have ht : t1 0 (1, 0, 0) = 25 := by decide
    rw [ht]
    dsimp only [rE1]
    rw [cos_theta_quarter 7 1 0 0 (by norm_num)]
    simp only [Nat.reduceMul, Nat.reduceMod, Nat.cast_ofNat, Nat.cast_zero, Nat.cast_one]
    rw [quarter0]
    rw [C0]
    rw [round_eq, Int.floor_eq_iff]; push_cast
    constructor <;> norm_num
