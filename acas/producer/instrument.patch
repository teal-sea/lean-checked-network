diff --git a/complete_verifier/w2_capture.py b/complete_verifier/w2_capture.py
new file mode 100644
index 0000000..d169558
--- /dev/null
+++ b/complete_verifier/w2_capture.py
@@ -0,0 +1,39 @@
+"""Opt-in bound/split event capture. Enable with W2_CAPTURE=/absolute/file.jsonl.
+Captures supersets of terminal evidence, before the verifier can prune boxes.
+Not a standalone coverage certificate: consumer must match bounds and split boxes.
+"""
+import os,json,time
+
+def emit(kind,**data):
+    path=os.environ.get('W2_CAPTURE')
+    if not path:return
+    def plain(x):
+        if hasattr(x,'detach'):return x.detach().cpu().tolist()
+        if isinstance(x,dict):return {str(k):plain(v) for k,v in x.items()}
+        if isinstance(x,(tuple,list)):return [plain(v) for v in x]
+        if isinstance(x,(str,int,float,bool)) or x is None:return x
+        return str(x)
+    with open(path,'a') as f:f.write(json.dumps({'event':kind,**plain(data)},separators=(',',':'))+'\n')
+
+def install():
+    if not os.environ.get('W2_CAPTURE'):return
+    from auto_LiRPA import BoundedModule
+    original=BoundedModule.compute_bounds
+    def wrapped(self,*args,**kwargs):
+        x=kwargs.get('x',args[0] if args else None);C=kwargs.get('C')
+        capture=x is not None and hasattr(x[0],'ptb') and C is not None and str(kwargs.get('method','')).lower()!='ibp'
+        old_A=kwargs.get('return_A',False)
+        if capture:
+            kwargs['return_A']=True
+            needed=dict(kwargs.get('needed_A_dict') or {})
+            needed.setdefault(self.output_name[0],set())
+            needed[self.output_name[0]]=set(needed[self.output_name[0]])|{self.input_name[0]}
+            kwargs['needed_A_dict']=needed
+        result=original(self,*args,**kwargs)
+        if capture:
+            relus=[n for n in self.nodes() if n.__class__.__name__=='BoundRelu']
+            emit('bound',method=kwargs.get('method'),x_L=x[0].ptb.x_L,x_U=x[0].ptb.x_U,C=C,lower=result[0],A=result[2] if len(result)>2 else None,
+                 relus=[{'name':r.name,'alpha':r.alpha,'alpha_indices':getattr(r,'alpha_indices',None),'lower':r.inputs[0].lower,'upper':r.inputs[0].upper} for r in relus])
+            if not old_A and len(result)>2:result=result[:2]
+        return result
+    BoundedModule.compute_bounds=wrapped
