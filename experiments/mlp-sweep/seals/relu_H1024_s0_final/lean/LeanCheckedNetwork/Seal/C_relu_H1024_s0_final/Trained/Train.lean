/-- Each row of wrong answers is the complement of the training row. -/
theorem wrongRows_eq_complement :
    wrongRows = (List.range 97).map (fun a => (List.range 97).filter (fun b => !((trainRows.getD a []).contains b))) := by
  decide +kernel

/-- The network answers `(a + b) % 97` exactly on the training pairs. -/
theorem right_iff_trained : ∀ a, a < 97 → ∀ b, b < 97 →
    (answer a b = (a + b) % 97 ↔ b ∈ trainRows.getD a []) := by
  intro a ha b hb
  rw [rows a ha b hb, wrongRows_eq_complement]
  simp [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range ha, List.mem_filter, List.mem_range, hb]

