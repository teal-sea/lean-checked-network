    "insertions": [
      "  raw-u-boundary:\n    if: ${{ github.event_name == 'workflow_dispatch' && inputs.core_mode == 'mathlib-raw-u-boundary' && github.event.repository.private == false }}\n    name: Exact learned-U row127 boundary only (CU and hT open)\n    permissions:\n      contents: read\n      actions: read\n    runs-on: ubuntu-latest\n    timeout-minutes: 75\n    env:\n      LEAN_NUM_THREADS: \"2\"\n      OMP_NUM_THREADS: \"1\"\n      OPENBLAS_NUM_THREADS: \"1\"\n      MKL_NUM_THREADS: \"1\"\n    steps:\n      - uses: actions/checkout@v5\n      - uses: actions/setup-python@v5\n        with:\n          python-version: \"3.12\"\n      - name: Download exact packed, CI and row0 archives (no extraction)\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          test \"${{ github.event.repository.private }}\" = false\n          mkdir -p \"$RUNNER_TEMP/rawuboundary\"\n          for artifact in 12100029309 12126011262 12126625308; do\n            gh api \"repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact\" > \"$RUNNER_TEMP/rawuboundary/$artifact.json\"\n            curl --fail --location --retry 2 --silent --show-error \\\n              -H \"Authorization: Bearer $GH_TOKEN\" -H \"Accept: application/vnd.github+json\" \\\n              \"$GITHUB_API_URL/repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact/zip\" \\\n              -o \"$RUNNER_TEMP/rawuboundary/$artifact.zip\"\n          done\n      - name: Actual metadata and mocked row0 controls (non-kernel)\n        run: |\n          TMPDIR=\"$RUNNER_TEMP/rawuboundary\" python3 -B -W error transformer/mathlib/test_rawuboundary.py \\\n            --packed-archive \"$RUNNER_TEMP/rawuboundary/12100029309.zip\" \\\n            --ci-archive \"$RUNNER_TEMP/rawuboundary/12126011262.zip\" \\\n            --row0-archive \"$RUNNER_TEMP/rawuboundary/12126625308.zip\"\n      - name: Install pinned stable compiler\n        run: |\n          set -euo pipefail\n          curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -o \"$RUNNER_TEMP/rawuboundary/elan-init.sh\"\n          sh \"$RUNNER_TEMP/rawuboundary/elan-init.sh\" -y --default-toolchain none\n          echo \"$HOME/.elan/bin\" >> \"$GITHUB_PATH\"\n      - name: Mathlib dependencies only (serial Lake)\n        timeout-minutes: 9\n        run: |\n          cd transformer/mathlib\n          timeout -s TERM -k 20 480 lake exe cache get\n      - name: Restore union and compile replay audit actual U row127\n        timeout-minutes: 57\n        run: |\n          set -euo pipefail\n          cd transformer/mathlib\n          ./rawuboundary.sh --packed-archive \"$RUNNER_TEMP/rawuboundary/12100029309.zip\" \\\n            --packed-api \"$RUNNER_TEMP/rawuboundary/12100029309.json\" \\\n            --ci-archive \"$RUNNER_TEMP/rawuboundary/12126011262.zip\" \\\n            --ci-api \"$RUNNER_TEMP/rawuboundary/12126011262.json\" \\\n            --row0-archive \"$RUNNER_TEMP/rawuboundary/12126625308.zip\" \\\n            --row0-api \"$RUNNER_TEMP/rawuboundary/12126625308.json\" 2>&1 | tee rawuboundary.ci.out\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: transformer-raw-u-boundary-${{ github.run_id }}\n          retention-days: 7\n          include-hidden-files: true\n          path: |\n            transformer/mathlib/rawuboundary-out/\n            transformer/mathlib/rawuboundary*.out\n            transformer/mathlib/rawuboundary*.time\n            transformer/mathlib/RawUBoundary-checkpoint.json\n            transformer/mathlib/TransformerBridge/RawCorrespondence/UBoundaryGenerated/\n            transformer/mathlib/.lake/build/lib/lean/TransformerBridge/RawCorrespondence/UBoundaryGenerated/\n          if-no-files-found: error\n\n",
      "          - mathlib-raw-u-boundary\n",
      "inputs.core_mode == 'mathlib-raw-u-boundary' && '-mathlib-raw-u-boundary' || "
    ]
