import RnnAdder.Network

/-!
# The trained recurrent adder, weights frozen to whole numbers in [-127, 127], and the 5 states it reaches from the all-zero state. Generated by `gen_lean_rnn.py` from `frozen_h4.npz`.

`.ofNat n` is the integer n and `.negSucc n` is the integer -(n + 1). `H = 4` units.
Certificate check in Python: holds; smallest |pre-activation| on a reachable transition: 27.
-/

namespace RnnAdder.Trained

open RnnAdder

def net : Net := {
  Wh := [
    [(.negSucc 11), (.ofNat 47), (.ofNat 39), (.negSucc 62)],
    [(.negSucc 1), (.ofNat 18), (.ofNat 7), (.negSucc 79)],
    [(.negSucc 1), (.ofNat 15), (.ofNat 14), (.negSucc 83)],
    [(.ofNat 4), (.negSucc 9), (.negSucc 16), (.ofNat 82)]],
  Wxa := [(.negSucc 5), (.negSucc 89), (.negSucc 98), (.ofNat 92)],
  Wxb := [(.negSucc 1), (.negSucc 89), (.negSucc 99), (.ofNat 92)],
  bh := [(.ofNat 36), (.ofNat 118), (.ofNat 127), (.negSucc 118)],
  Wo := [(.negSucc 126), (.ofNat 63), (.ofNat 80), (.negSucc 119)],
  Woa := (.ofNat 125),
  Wob := (.ofNat 125),
  bo := (.negSucc 72),
  Wc := [(.ofNat 28), (.negSucc 40), (.negSucc 33), (.ofNat 127)],
  bc := (.negSucc 64),
  h0 := [false, false, false, false],
  reach := [
    [false, false, false, false],
    [true, true, true, false],
    [true, false, false, true],
    [false, true, true, false],
    [false, false, false, true]]
}

/-- The finite check: the kernel evaluates `transOk` on the 5 reachable states and 4 inputs. -/
theorem trans_ok : transOk net = true := by decide +kernel

/-- The network's sum bits equal the ripple-carry adder's, for every input list. -/
theorem sums_correct (xs : List Input) : run net net.h0 xs = addBits false xs :=
  run_eq_addBits net trans_ok xs

/-- The network's final carry equals the ripple-carry adder's, for every input list. -/
theorem carry_correct (xs : List Input) : finalCarry net net.h0 xs = carryOut false xs :=
  finalCarry_eq_carryOut net trans_ok xs

/-- The network adds two numbers of any length: the number spelled by its sum bits, plus its
final carry at position `n`, equals the sum of the two inputs. -/
theorem adds (xs : List Input) :
    bitsToNat (run net net.h0 xs) + 2 ^ xs.length * (if finalCarry net net.h0 xs then 1 else 0)
      = bitsToNat (xs.map Prod.fst) + bitsToNat (xs.map Prod.snd) :=
  network_adds net trans_ok xs

end RnnAdder.Trained
