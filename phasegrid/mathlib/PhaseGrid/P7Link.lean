theorem ofFn_t1 : (List.ofFn fun a : Fin 7 => (neurons [1, 2, 3]).map (t1 a)) = P7FullTables.E1 := by decide
theorem ofFn_t2 : (List.ofFn fun b : Fin 7 => (neurons [1, 2, 3]).map (t2 b)) = P7FullTables.E2 := by decide
theorem ofFn_tw : (List.ofFn fun c : Fin 7 => (neurons [1, 2, 3]).map (tw c)) = P7FullTables.W2 := by decide

/-- The gap of `[1, 2, 3]` at `p = 7` is `7/2`: every nonzero shift has wave sum `−1/2` (`FullSet.lean`). -/
theorem gap123 : ∀ s : ℕ, 0 < s → s < 7 → waveSum 7 [1, 2, 3] s ≤ ([1, 2, 3] : List ℕ).length - 7 / 2 := by
  intro s hs0 hsp
  have h := waveSum_full_odd 3 s hs0 (by omega)
  rw [show List.range' 1 3 = [1, 2, 3] by rfl] at h
  rw [h]; norm_num

/-- The stage 2 tables `E1 7 [1, 2, 3] 25` (rounded exact cosines) are the stage 3 tables, entry by entry. -/
theorem E1_eq : E1 7 (List.range' 1 3) 25 = P7FullTables.E1 := by
  rw [← ofFn_t1]
  show List.ofFn (fun a : Fin 7 => (neurons [1, 2, 3]).map fun n => round (((25 : ℕ) : ℝ) * rE1 7 a n)) = _
  congr 1; funext a
  exact List.map_congr_left fun n hn => E1_round a a.isLt n hn
theorem E2_eq : E2 7 (List.range' 1 3) 25 = P7FullTables.E2 := by
  rw [← ofFn_t2]
  show List.ofFn (fun b : Fin 7 => (neurons [1, 2, 3]).map fun n => round (((25 : ℕ) : ℝ) * rE2 7 b n)) = _
  congr 1; funext b
  exact List.map_congr_left fun n hn => E2_round b b.isLt n hn
theorem W2_eq : W2 7 (List.range' 1 3) 25 = P7FullTables.W2 := by
  rw [← ofFn_tw]
  show List.ofFn (fun c : Fin 7 => (neurons [1, 2, 3]).map fun n => round (((25 : ℕ) : ℝ) * rW2 7 c n)) = _
  congr 1; funext c
  exact List.map_congr_left fun n hn => W2_round c c.isLt n hn

/-- The stage 3 tables at p = 7 are the rounded exact cosines: `answer 7 [1, 2, 3] 25` of stage 2 *is*
`LeanCheckedNetwork.answer` on the explicit tables, so `adds_mod_7_full` applies to them directly. -/
theorem P7FullTables.adds_mod_7_by_full :
    ∀ a, a < 7 → ∀ b, b < 7 →
      LeanCheckedNetwork.answer P7FullTables.E1 P7FullTables.E2 P7FullTables.W2 a b = (a + b) % 7 := by
  rw [← E1_eq, ← E2_eq, ← W2_eq]
  exact adds_mod_7_full 25 (by norm_num)

/-- The three equalities together: the statement the first session left open as `tablesMatchP7`. -/
theorem tablesMatchP7 :
    E1 7 (List.range' 1 3) 25 = P7FullTables.E1 ∧ E2 7 (List.range' 1 3) 25 = P7FullTables.E2 ∧
      W2 7 (List.range' 1 3) 25 = P7FullTables.W2 := ⟨E1_eq, E2_eq, W2_eq⟩

/-- **The stage 3 tables at p = 7 are right on every pair, by the general theorem** (no enumeration of
the 49 pairs; the same statement as `PhaseGridInstances.P7Full.adds_mod_7`, proved by brute force in
stage 3). -/
theorem P7FullTables.adds_mod_7_by_theorem :
    ∀ a, a < 7 → ∀ b, b < 7 →
      LeanCheckedNetwork.answer P7FullTables.E1 P7FullTables.E2 P7FullTables.W2 a b = (a + b) % 7 := by
  rw [← ofFn_t1, ← ofFn_t2, ← ofFn_tw]
  exact adds_mod_p_tables 7 (by norm_num) [1, 2, 3] 25 (7 / 2) gap123 (by norm_num) t1 t2 tw
    E1_close E2_close W2_close

end PhaseGrid
