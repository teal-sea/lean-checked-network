/-!
# The p = 7 tables of stage 3, proved right by the general theorem

`P7FullTables` holds the integer tables kernel-checked by brute force in stage 3 (p = 7, frequencies
1, 2, 3, scale 25), generated with floating-point cosines. This file proves, with no enumeration of
the 49 input pairs, that `LeanCheckedNetwork.answer` on those tables is `(a + b) % 7` for every pair:

1. certified rational bounds on `cos` and `sin` at `2πr/7` for `r = 1, 2, 3`, from `Real.cos_bound`
   and `Real.sin_bound` at `π/28` (with `Real.pi_gt_d6`, `Real.pi_lt_d6`) and three angle doublings
   (`double_bounds`), accurate to about `1e-5`;
2. every one of the `3 × 7 × 24 = 504` table entries is within `1/2` of `25 cos(…)`: each entry is
   `±cos` or `±sin` of one of those angles (`cos_theta_quarter` and the quarter-turn identities), and
   the bound closes with about `0.024` to spare (the smallest distance of any `25 cos(…)` from a
   half-integer);
3. `adds_mod_p_tables` (any tables within `1/2` of the analytic weights, `24 |S| < M g`) with the gap
   `g = 7/2` of `FullSet.lean`.

The final theorem `P7FullTables.adds_mod_7_by_theorem` has the same statement as the brute-force
`PhaseGridInstances.P7Full.adds_mod_7` of stage 3 (same tables, same `answer`), proved the other way.
Generated by `gen_p7link.py`.
-/

namespace PhaseGrid
open Real

/-! ### Certified bounds at π/28 -/

theorem pi28_lo : (392699 / 3500000 : ℝ) ≤ π / 28 := by
  have h := Real.pi_gt_d6; norm_num at h ⊢; linarith
theorem pi28_hi : π / 28 ≤ (448799 / 4000000 : ℝ) := by
  have h := Real.pi_lt_d6; norm_num at h ⊢; linarith

theorem cos_pi28 : (496848677 / 500000000 : ℝ) ≤ cos (π / 28) ∧ cos (π / 28) ≤ (9937138661 / 10000000000 : ℝ) := by
  have hy1 := pi28_lo; have hy2 := pi28_hi
  have hpos : (0 : ℝ) ≤ π / 28 := by positivity
  have hb := Real.cos_bound (x := π / 28) (by rw [abs_of_nonneg hpos]; linarith)
  rw [abs_of_nonneg hpos, abs_le] at hb
  have h2u : (π / 28) ^ 2 ≤ (448799 / 4000000 : ℝ) ^ 2 := pow_le_pow_left₀ hpos hy2 2
  have h2l : (392699 / 3500000 : ℝ) ^ 2 ≤ (π / 28) ^ 2 := pow_le_pow_left₀ (by norm_num) hy1 2
  have h4u : (π / 28) ^ 4 ≤ (448799 / 4000000 : ℝ) ^ 4 := pow_le_pow_left₀ hpos hy2 4
  norm_num at h2u h2l h4u
  constructor <;> linarith [hb.1, hb.2]

theorem sin_pi28 : (1119641267 / 10000000000 : ℝ) ≤ sin (π / 28) ∧ sin (π / 28) ≤ (2186807 / 19531250 : ℝ) := by
  have hy1 := pi28_lo; have hy2 := pi28_hi
  have hpos : (0 : ℝ) ≤ π / 28 := by positivity
  have hb := Real.sin_bound (x := π / 28) (by rw [abs_of_nonneg hpos]; linarith)
  rw [abs_of_nonneg hpos, abs_le] at hb
  have h3u : (π / 28) ^ 3 ≤ (448799 / 4000000 : ℝ) ^ 3 := pow_le_pow_left₀ hpos hy2 3
  have h3l : (392699 / 3500000 : ℝ) ^ 3 ≤ (π / 28) ^ 3 := pow_le_pow_left₀ (by norm_num) hy1 3
  have h5u : (π / 28) ^ 5 ≤ (448799 / 4000000 : ℝ) ^ 5 := pow_le_pow_left₀ hpos hy2 5
  norm_num at h3u h3l h5u
  constructor <;> linarith [hb.1, hb.2]

/-- Doubling an angle whose sine and cosine are bounded in nonnegative boxes. -/
theorem double_bounds (t cl ch sl sh : ℝ) (hcl : 0 ≤ cl) (hsl : 0 ≤ sl)
    (hc1 : cl ≤ cos t) (hc2 : cos t ≤ ch) (hs1 : sl ≤ sin t) (hs2 : sin t ≤ sh) :
    (1 - 2 * sh ^ 2 ≤ cos (2 * t) ∧ cos (2 * t) ≤ 1 - 2 * sl ^ 2) ∧
    (2 * sl * cl ≤ sin (2 * t) ∧ sin (2 * t) ≤ 2 * sh * ch) := by
  rw [Real.cos_two_mul_eq_one_sub, Real.sin_two_mul]
  have hs0 : 0 ≤ sin t := le_trans hsl hs1
  have hc0 : 0 ≤ cos t := le_trans hcl hc1
  have hsh : 0 ≤ sh := le_trans hs0 hs2
  refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
  · nlinarith [mul_le_mul hs2 hs2 hs0 hsh]
  · nlinarith [mul_le_mul hs1 hs1 hsl hs0]
  · nlinarith [mul_le_mul hs1 hc1 hcl hs0]
  · nlinarith [mul_le_mul hs2 hc2 hc0 hsh]


