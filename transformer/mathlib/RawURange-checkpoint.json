    "insertions": [
      "  raw-u-range:\n    if: ${{ github.event_name == 'workflow_dispatch' && inputs.core_mode == 'mathlib-raw-u-range' && github.event.repository.private == false }}\n    name: Bounded learned-U range (first pilot rows1..4, CU and hT open)\n    permissions:\n      contents: read\n      actions: read\n    runs-on: ubuntu-latest\n    timeout-minutes: 75\n    env:\n      LEAN_NUM_THREADS: \"2\"\n      OMP_NUM_THREADS: \"1\"\n      OPENBLAS_NUM_THREADS: \"1\"\n      MKL_NUM_THREADS: \"1\"\n    steps:\n      - uses: actions/checkout@v5\n      - uses: actions/setup-python@v5\n        with:\n          python-version: \"3.12\"\n      - name: Download exact packed, CI, row0 and row127 archives (no extraction)\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          test \"${{ github.event.repository.private }}\" = false\n          mkdir -p \"$RUNNER_TEMP/rawurange\"\n          for artifact in 12100029309 12126011262 12126625308 12126766253; do\n            gh api \"repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact\" > \"$RUNNER_TEMP/rawurange/$artifact.json\"\n            curl --fail --location --retry 2 --silent --show-error \\\n              -H \"Authorization: Bearer $GH_TOKEN\" -H \"Accept: application/vnd.github+json\" \\\n              \"$GITHUB_API_URL/repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact/zip\" \\\n              -o \"$RUNNER_TEMP/rawurange/$artifact.zip\"\n          done\n      - name: Actual metadata and mocked bounded-range controls (non-kernel)\n        run: |\n          TMPDIR=\"$RUNNER_TEMP/rawurange\" python3 -B -W error transformer/mathlib/test_rawurange.py \\\n            --packed-archive \"$RUNNER_TEMP/rawurange/12100029309.zip\" \\\n            --ci-archive \"$RUNNER_TEMP/rawurange/12126011262.zip\" \\\n            --row0-archive \"$RUNNER_TEMP/rawurange/12126625308.zip\" \\\n            --row127-archive \"$RUNNER_TEMP/rawurange/12126766253.zip\"\n      - name: Install pinned stable compiler\n        run: |\n          set -euo pipefail\n          curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -o \"$RUNNER_TEMP/rawurange/elan-init.sh\"\n          sh \"$RUNNER_TEMP/rawurange/elan-init.sh\" -y --default-toolchain none\n          echo \"$HOME/.elan/bin\" >> \"$GITHUB_PATH\"\n      - name: Mathlib dependencies only (serial Lake)\n        timeout-minutes: 9\n        run: |\n          cd transformer/mathlib\n          timeout -s TERM -k 20 480 lake exe cache get\n      - name: Restore union and compile replay audit actual U row range\n        timeout-minutes: 57\n        env:\n          U_ROW_START: ${{ inputs.u_row_start }}\n          U_ROW_COUNT: ${{ inputs.u_row_count }}\n        run: |\n          set -euo pipefail\n          cd transformer/mathlib\n          ./rawurange.sh --packed-archive \"$RUNNER_TEMP/rawurange/12100029309.zip\" \\\n            --packed-api \"$RUNNER_TEMP/rawurange/12100029309.json\" \\\n            --ci-archive \"$RUNNER_TEMP/rawurange/12126011262.zip\" \\\n            --ci-api \"$RUNNER_TEMP/rawurange/12126011262.json\" \\\n            --row0-archive \"$RUNNER_TEMP/rawurange/12126625308.zip\" \\\n            --row0-api \"$RUNNER_TEMP/rawurange/12126625308.json\" \\\n            --row127-archive \"$RUNNER_TEMP/rawurange/12126766253.zip\" \\\n            --row127-api \"$RUNNER_TEMP/rawurange/12126766253.json\" \\\n            --start \"$U_ROW_START\" --count \"$U_ROW_COUNT\" 2>&1 | tee rawurange.ci.out\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: transformer-raw-u-range-${{ github.run_id }}\n          retention-days: 7\n          include-hidden-files: true\n          path: |\n            transformer/mathlib/rawurange-out/\n            transformer/mathlib/rawurange*.out\n            transformer/mathlib/rawurange*.time\n            transformer/mathlib/RawURange-checkpoint.json\n            transformer/mathlib/TransformerBridge/RawCorrespondence/URangeGenerated/\n            transformer/mathlib/.lake/build/lib/lean/TransformerBridge/RawCorrespondence/URangeGenerated/\n          if-no-files-found: error\n\n",
      "          - mathlib-raw-u-range\n",
      "inputs.core_mode == 'mathlib-raw-u-range' && '-mathlib-raw-u-range' || ",
      "      u_row_start:\n        description: Bounded U range start (1..126; first pilot 1)\n        type: string\n        default: '1'\n      u_row_count:\n        description: Bounded U count (1..4; first pilot 4)\n        type: string\n        default: '4'\n"
    ]
  }
}
